{
  "repo": "ARMOR-SERVER",
  "ecosystem": "armor",
  "tagline": "The one that decides and acts: it takes in what the nodes say and answers the consoles.",
  "description": "Field nodes post their messages over MQTT or HTTP with an ingest token; ARMOR-STUDIO and the Android app call the HTTP interface with a session or a token. Inside ARMOR-SERVER the messages are checked against the contracts of ARMOR-COMMON, the person is authenticated and authorised, rules and alarms run, cameras are reached over RTSP and ONVIF, and the state and the audit trail are kept on disk. The voice service of ARMOR-VOICE-AI is asked on the loopback address.",
  "columns": ["WHO CALLS IT", "WHAT RUNS INSIDE", "WHAT IT REACHES"],
  "nodes": [
    {"id": "nodes", "column": 0, "level": "external", "title": "Field nodes",
     "lines": ["ESP32-S3 radar, solar, electrical,", "alarm and network nodes"]},
    {"id": "studio", "column": 0, "level": "external", "title": "ARMOR-STUDIO",
     "lines": ["HttpOnly session, JSON,", "WebSocket events, MJPEG"]},
    {"id": "android", "column": 0, "level": "external", "title": "ARMOR-ANDROID-CONTROL",
     "title_size": 12, "lines": ["JSON and MJPEG with its", "own token"]},
    {"id": "ingest", "column": 1, "level": "tested", "title": "mqtt_router.ts",
     "lines": ["each message is checked against", "the ARMOR-COMMON contracts;", "the topic must name its node"],
     "code": ["src/mqtt_router.ts", "src/contracts.ts", "src/routes/ingest.ts"]},
    {"id": "cameras", "column": 1, "level": "tested", "title": "cameras/",
     "lines": ["RTSP and ONVIF, digest login;", "passwords sealed in vault.ts", "and never returned by an API"],
     "code": ["src/cameras/vault.ts", "src/cameras/rtsp.ts", "src/cameras/discovery.ts"]},
    {"id": "auth", "column": 1, "level": "contract", "title": "http/auth.ts",
     "lines": ["secrets compared in constant", "time; three roles; second", "factor; login rate limited"],
     "code": ["src/http/auth.ts", "src/users.ts", "src/totp.ts"]},
    {"id": "persist", "column": 1, "level": "tested", "title": "persistence.ts",
     "lines": ["state.json with a .bak copy;", "audit.log, one line per decision"],
